<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Venue_Required_When_Published</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, "Published"), ISBLANK(Venue__c))</errorConditionFormula>
    <errorDisplayField>Venue__c</errorDisplayField>
    <errorMessage>A venue is required before an event can be published.</errorMessage>
</ValidationRule>
